# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored, so keys never get committed.
#
# Also set these same variables in the hosting provider (Cloudflare Pages or
# Vercel -> Environment Variables) for the deployed app.

# Supabase — the client (publishable/anon) key is safe to expose; RLS protects data.
# Local dev should point at the DEMO project; production at the live project.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# TMDB (The Movie Database) API key (posters, credits, search)
# Get one free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=
