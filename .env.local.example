# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored, so keys never get committed.
#
# Also set these same variables in the hosting provider (Vercel ->
# Project Settings -> Environment Variables) for the deployed app.

# Google Gemini API key (AI film analysis + list suggestions)
GEMINI_API_KEY=

# TMDB (The Movie Database) API key (posters, credits, search)
# Get one free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=
